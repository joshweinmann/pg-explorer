{
  "name": "pg-explorer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "build": "bun build --compile src/main.ts --outfile pg-explorer",
    "install": "bun run build && install -m755 pg-explorer ~/.local/bin/pg-explorer"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "postgres": "^3.4.9",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
